# SAFE сохраняется по умолчанию. LIVE всё равно требует отдельного подтверждения каждого run.
RUN_MODE=SAFE

# Legacy single LLM connection. Dashboard может хранить несколько connections в private/.
# Поддержаны: anthropic | openai | yandex | gemini | groq | zai | none
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
YANDEX_FOLDER_ID=

# Выбранное exact HH resume. Заполняется dashboard.
RESUME_URL=

# Browser worker.
HEADLESS=0
PAGES_PER_RUN=3
PAUSE_SECONDS=6

# Stop после этого числа явно подтверждённых новых откликов в одном LIVE-run.
TARGET_APPLICATIONS_PER_RUN=30
# Legacy fallback для TARGET_APPLICATIONS_PER_RUN, не календарный дневной счётчик.
DAILY_LIMIT=30
SCORE_THRESHOLD=90

# HH search. Пустой AREA = весь мир (параметр area не передаётся).
SEARCH_TEXT=Project Manager
AREA=
SALARY_MIN=0
# CURRENT browser path всегда запрашивает REMOTE; поле сохранено для совместимости UI.
WORK_FORMAT=remote_only
EXPERIENCE=
EMPLOYMENT=
SCHEDULE=
SEARCH_PERIOD=
ORDER_BY=publication_time

# Локальные hard filters по поисковой карточке.
# STOPWORDS: case-insensitive substring ТОЛЬКО в title, без морфологии/whole-word/ё-е normalization.
STOPWORDS=стажёр,стажер,junior
# BLACKLIST_EMPLOYERS: case-insensitive substring в имени работодателя.
BLACKLIST_EMPLOYERS=

# Legacy API path (run.py/hh_client.py), не основной browser production path.
HH_ACCESS_TOKEN=
HH_RESUME_ID=
