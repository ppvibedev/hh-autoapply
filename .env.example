# --- Способ работы ---
# Браузерная автоматизация (Playwright) не требует токена API:
# отклик закрыт в API для сторонних приложений, поэтому ходим через сайт.
# Логин делается один раз командой:  python login.py

# --- hh.ru API (нужно только для варианта на официальном API, run.py) ---
HH_ACCESS_TOKEN=
HH_RESUME_ID=

# --- ИИ для сопроводительных писем ---
LLM_PROVIDER=anthropic     # anthropic | openai | none
LLM_API_KEY=
LLM_MODEL=                 # пусто = дефолт (anthropic: claude-haiku-4-5, openai: gpt-4o-mini)
RESUME_URL=

# --- Браузер ---
HEADLESS=0          # 0 = видимый браузер (нужно, если появится капча)
PAGES_PER_RUN=3     # страниц выдачи за прогон (≤ 60-100 вакансий — не наглеть)
PAUSE_SECONDS=6     # пауза между действиями, сек (антибот hh.ru)

# --- Режим работы ---
# 1 = shadow (боевой POST /negotiations ВЫКЛЮЧЕН, только лог «откликнулся бы»)
# 0 = боевой автопилот (реальные отклики)
DRY_RUN=1

# --- Предохранители ---
# Максимум реальных откликов за один запуск (лимит hh.ru — 200/сутки, держим ниже).
DAILY_LIMIT=30
# Порог матчинга для автоотклика (0..100). Ниже — не откликаемся.
SCORE_THRESHOLD=90

# --- Фильтры поиска (HARD) ---
SEARCH_TEXT=Python backend developer
AREA=2                 # 1=Москва, 2=Санкт-Петербург (справочник /areas)
SALARY_MIN=250000      # минимальная зарплата, ₽; ниже — отбой
# Формат работы: any = любой | remote_ok = можно удалённо (удалёнка+гибрид) | remote_only = только удалёнка
WORK_FORMAT=any
# Стоп-слова в заголовке/описании (через запятую) — совпадение = отбой
STOPWORDS=стажёр,стажер,junior,холодные звонки,оператор
# Чёрный список компаний (через запятую, по вхождению в название)
BLACKLIST_EMPLOYERS=
