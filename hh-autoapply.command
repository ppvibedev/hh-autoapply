#!/usr/bin/env bash
# Ярлык запуска. Двойной клик в Finder — поднимает дашборд и открывает браузер.
# Первый запуск сам ставит окружение, если его ещё нет.
cd "$(dirname "$0")"

# Первый запуск: нет окружения — установить.
if [ ! -d .venv ]; then
  echo "Первый запуск — устанавливаю (2–3 минуты)..."
  if ! bash setup.sh; then
    echo ""; echo "Ошибка установки. Проверь, что установлен Python 3 (python3 --version)."
    read -p "Нажми Enter, чтобы закрыть..."; exit 1
  fi
fi

# Открыть браузер, когда сервер поднимется.
( sleep 2; open "http://127.0.0.1:8000" ) &

echo ""
echo "==============================================="
echo "  Автоотклик hh.ru запущен"
echo "  Дашборд: http://127.0.0.1:8000"
echo "  Чтобы ОСТАНОВИТЬ — закрой это окно (или Ctrl+C)"
echo "==============================================="
echo ""

./.venv/bin/python webapp.py
